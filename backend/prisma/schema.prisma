generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  ACTIVE
  INACTIVE
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum UserLevel {
  COMPANY
  ORG
}

enum RoleType {
  COMPANY
  ORG
}

model Company {
  id        Int        @id @default(autoincrement())
  name      String
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

model User {
  id        Int        @id @default(autoincrement())
  username  String     @unique
  password  String
  firstName String
  lastName  String
  mobile    String
  status    UserStatus @default(ACTIVE)
  userLevel UserLevel

  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  userRoles UserRole[]
  approvals Approval[]
  createdRequests Request[] @relation("RequestCreator")
}

model Role {
  id       Int      @id @default(autoincrement())
  name     String
  type     RoleType

  orgId    Int?            // null for COMPANY roles, set for ORG roles
  org      Organization?   @relation(fields: [orgId], references: [id])

  userRoles UserRole[]

  @@unique([name, orgId]) // same role name can exist in different orgs
}

model UserRole {
  id        Int      @id @default(autoincrement())
  userId    Int
  roleId    Int

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, roleId])
  @@index([userId])
  @@index([roleId])
}

model Patient {
  id          Int       @id @default(autoincrement())
  regDate     DateTime?  @db.Date
  uhidNo      String?
  patientName String
  address1    String?
  age         Int?
  bloodGroup  String?
  mobileNo    String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  incomeTxns IncomeTxn[]

  @@unique([uhidNo], map: "Patient_uhidNo_key")
}

model Doctor {
  id        Int      @id @default(autoincrement())
  name      String
  degree    String
  descName  String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  payables  Payable[]
}

model Organization {
  id        Int        @id @default(autoincrement())
  name      String
  status    OrgStatus  @default(ACTIVE)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  roles     Role[]
  requests  Request[]
}

enum OrgStatus {
  ACTIVE
  INACTIVE
}

model Request {
  id          Int            @id @default(autoincrement())
  orgId       Int
  title       String
  description String?
  status      ApprovalStatus @default(PENDING)
  createdBy   Int
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  creator      User         @relation("RequestCreator", fields: [createdBy], references: [id])
  approvals    Approval[]

  @@index([orgId])
  @@index([createdBy])
}

model Approval {
  id         Int            @id @default(autoincrement())
  requestId   Int
  approverId Int
  approvalRoleId Int?       // which role approved (optional)
  status     ApprovalStatus @default(PENDING)
  comment    String?
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  request    Request        @relation(fields: [requestId], references: [id], onDelete: Cascade)
  approver   User           @relation(fields: [approverId], references: [id], onDelete: Cascade)

  @@unique([requestId, approverId])
  @@index([approverId])
}

enum IncomeStatus {
  FULLYPAID
  PARTIALPAID
  UNPAID
  ERROR
}

enum PayableType {
  DOCTOR
}

enum PayableStatus {
  PENDING
  PARTIALLY_PAID
  PAID
  CANCELLED
}

model IncomeSource {
  id       Int     @id @default(autoincrement())
  code     String  @unique @db.VarChar(20)
  name     String  @db.VarChar(100)
  isActive Boolean @default(true)

  incomeTxns IncomeTxn[]

  @@map("income_src")
}

model PaymentMode {
  id   Int    @id @default(autoincrement())
  code String @unique @db.VarChar(20)
  name String @db.VarChar(50)

  rcvdPymts    RcvdPymt[]
  payablePymts PayablePymt[]

  @@map("payment_mode")
}

model IncomeTxn {
  id             Int          @id @default(autoincrement())
  incomeSourceId Int
  patientId      Int?
  billNo         String       @unique @db.VarChar(50)
  billDate       DateTime?    @db.Date
  ipNo           String?      @db.VarChar(50)
  grossAmount    Decimal?     @db.Decimal(12, 2)
  discountAmount Decimal?     @db.Decimal(12, 2)
  advAdjt        Decimal?     @db.Decimal(12, 2)
  netAmount      Decimal?     @db.Decimal(12, 2)
  status         IncomeStatus
  errorReason    String?      @db.Text
  createdAt      DateTime     @default(now())

  incomeSource IncomeSource @relation(fields: [incomeSourceId], references: [id])
  patient      Patient?     @relation(fields: [patientId], references: [id])
  rcvdPymts    RcvdPymt[]
  payables     Payable[]

  @@index([incomeSourceId])
  @@index([patientId])
  @@index([billNo])
  @@map("income_txn")
}

model RcvdPymt {
  id            Int       @id @default(autoincrement())
  incomeTxnId   Int
  paymentModeId Int?
  amount        Decimal?  @db.Decimal(12, 2)
  paymentDate   DateTime? @db.Date
  transactionNo String?   @db.VarChar(100)
  bankName      String?   @db.VarChar(100)
  paidBy        String?   @db.VarChar(100)
  remarks       String?

  incomeTxn   IncomeTxn   @relation(fields: [incomeTxnId], references: [id], onDelete: Cascade)
  paymentMode PaymentMode? @relation(fields: [paymentModeId], references: [id])

  @@index([incomeTxnId])
  @@index([paymentModeId])
  @@map("rcvd_pymts")
}

model ImportLog {
  id            Int      @id @default(autoincrement())
  fileName      String   @db.VarChar(255)
  fileType      String   @db.VarChar(50)
  totalRecords  Int      @default(0)
  inserted      Int      @default(0)
  updated       Int      @default(0)
  skipped       Int      @default(0)
  failed        Int      @default(0)
  importStarted DateTime @default(now())
  importEnded   DateTime?
  createdBy     Int?

  errors ImportError[]

  @@index([createdBy])
  @@map("import_log")
}

model ImportError {
  id          Int      @id @default(autoincrement())
  importLogId Int
  rowNumber   Int
  rowData     String   @db.Text
  reason      String   @db.Text

  importLog ImportLog @relation(fields: [importLogId], references: [id], onDelete: Cascade)

  @@index([importLogId])
  @@map("import_error")
}

model Payable {
  id           Int             @id @default(autoincrement())
  payableType  PayableType
  partyId      Int
  incomeTxnId  Int
  billDate     DateTime        @db.Date
  dueDate      DateTime?       @db.Date
  billedAmt    Decimal         @db.Decimal(12, 2)
  payableAmt   Decimal?        @db.Decimal(12, 2)
  balanceAmt   Decimal         @db.Decimal(12, 2)
  status       PayableStatus   @default(PENDING)
  remarks      String?         @db.Text
  createdBy    String?         @db.VarChar(100)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  incomeTxn  IncomeTxn   @relation(fields: [incomeTxnId], references: [id], onDelete: Cascade)
  doctor     Doctor?     @relation(fields: [partyId], references: [id])
  pymts      PayablePymt[]

  @@index([incomeTxnId])
  @@index([partyId])
  @@map("payable")
}

model PayablePymt {
  id            Int         @id @default(autoincrement())
  payableId     Int
  paymentModeId Int?
  amount        Decimal?    @db.Decimal(12, 2)
  paymentDate   DateTime?
  transactionNo String?     @db.VarChar(100)
  bankName      String?     @db.VarChar(100)
  paidBy        String?     @db.VarChar(100)
  remarks       String?

  payable     Payable      @relation(fields: [payableId], references: [id], onDelete: Cascade)
  paymentMode PaymentMode? @relation(fields: [paymentModeId], references: [id])

  @@index([payableId])
  @@index([paymentModeId])
  @@map("payable_pymts")
}
