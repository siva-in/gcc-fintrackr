generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  ACTIVE
  INACTIVE
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum UserLevel {
  COMPANY
  ORG
}

enum RoleType {
  COMPANY
  ORG
}


enum OrgStatus {
  ACTIVE
  INACTIVE
}

model Company {
  id        Int      @id @default(autoincrement())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Organization {
  id        Int       @id @default(autoincrement())
  name      String
  status    OrgStatus @default(ACTIVE)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  roles    Role[]
  requests Request[]
}


model User {
  id        Int        @id @default(autoincrement())
  username  String     @unique
  password  String
  firstName String
  lastName  String
  mobile    String
  status    UserStatus @default(ACTIVE)
  userLevel UserLevel

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userRoles       UserRole[]
  approvals       Approval[]
  createdRequests Request[]  @relation("RequestCreator")
}

model Role {
  id   Int      @id @default(autoincrement())
  name String
  type RoleType

  orgId Int? // null for COMPANY roles, set for ORG roles
  org   Organization? @relation(fields: [orgId], references: [id])

  userRoles UserRole[]

  @@unique([name, orgId]) // same role name can exist in different orgs
}

model UserRole {
  id     Int @id @default(autoincrement())
  userId Int
  roleId Int

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, roleId])
  @@index([userId])
  @@index([roleId])
}
model Request {
  id          Int            @id @default(autoincrement())
  orgId       Int
  title       String
  description String?
  status      ApprovalStatus @default(PENDING)
  createdBy   Int
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  creator      User         @relation("RequestCreator", fields: [createdBy], references: [id])
  approvals    Approval[]

  @@index([orgId])
  @@index([createdBy])
}

model Approval {
  id             Int            @id @default(autoincrement())
  requestId      Int
  approverId     Int
  approvalRoleId Int? // which role approved (optional)
  status         ApprovalStatus @default(PENDING)
  comment        String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  request  Request @relation(fields: [requestId], references: [id], onDelete: Cascade)
  approver User    @relation(fields: [approverId], references: [id], onDelete: Cascade)

  @@unique([requestId, approverId])
  @@index([approverId])
}
model ImportLog {
  id            Int       @id @default(autoincrement())
  fileName      String    @db.VarChar(255)
  fileType      String    @db.VarChar(50)
  totalRecords  Int       @default(0)
  inserted      Int       @default(0)
  updated       Int       @default(0)
  skipped       Int       @default(0)
  failed        Int       @default(0)
  importStarted DateTime  @default(now())
  importEnded   DateTime?
  createdBy     Int?

  errors ImportError[]

  @@index([createdBy])
  @@map("import_log")
}

model ImportError {
  id          Int    @id @default(autoincrement())
  importLogId Int
  rowNumber   Int
  rowData     String @db.Text
  reason      String @db.Text

  importLog ImportLog @relation(fields: [importLogId], references: [id], onDelete: Cascade)

  @@index([importLogId])
  @@map("import_error")
}

model Patient {
  id         Int       @id @default(autoincrement())
  regDate    DateTime? @db.Date
  uhid       String?   @unique
  name       String
  lname      String?
  address1   String?
  age        Int?
  bloodGroup String?
  mobileNo   String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  incomeTxns  IncomeTxn[]
  receivables Receivable[]
  ipAdms      IPAdm[]

  @@index([uhid])
  @@index([name])
  @@map("patient")
}

model Doctor {
  id        Int      @id @default(autoincrement())
  name      String
  lname     String?
  degree    String
  descName  String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  payables Payable[]

  @@index([name])
}





enum IncomeStatus {
  FULLYPAID
  PARTIALPAID
  UNPAID
  UNREALISED
  REALISED
}

enum TxnStatus {
  VERIFIED
  UNVERIFIED
  REVIEW_REQ
  ERROR
}

enum PartyType {
  DOCTOR
  VENDOR
  INSURANCE
  CORPORATE
  PATIENT
  EMPLOYEE
  LAB
  RADIOLOGY
  GOVERNMENT
  OTHER
  REFERRAL

  @@map("party_type_enum")
}

enum PayableStatus {
  PENDING
  PARTIALLY_PAID
  PAID
  CANCELLED
}

enum ConfigCategory {
  IP_FILTER
}

enum IPStatus {
  ADMITTED
  DISCHARGED
  CANCELLED

  @@map("ip_status_enum")
}

model ConfigMaster {
  id       Int            @id @default(autoincrement())
  category ConfigCategory
  code     String         @db.VarChar(100)
  value    String         @db.VarChar(500)
  createdAt DateTime       @default(now()) @map("created_at")
  updatedAt DateTime       @updatedAt @map("updated_at")

  @@unique([category, code])
  @@map("config_master")
}

model IncomeSource {
  id       Int     @id @default(autoincrement())
  code     String  @unique @db.VarChar(20)
  name     String  @db.VarChar(100)
  isActive Boolean @default(true)
  incomeTxns IncomeTxn[]

  @@index([code])
  @@map("income_src")
}

model PaymentMode {
  id   Int    @id @default(autoincrement())
  code String @unique @db.VarChar(20)
  name String @db.VarChar(50)

  rcvdPymts    RcvdPymt[]
  payablePymts PayablePymt[]
  rcvlPymts    RcvlPymt[]

  @@index([code])
  @@map("payment_mode")
}

model IncomeTxn {
  id             Int          @id @default(autoincrement())
  incomeSourceId Int
  patientId      Int?
  billNo         String       @unique @db.VarChar(50)
  billDate       DateTime?    @db.Date
  ipId           Int?         @map("ip_id")
  grossAmount    Decimal?     @db.Decimal(12, 2)
  discountAmount Decimal?     @db.Decimal(12, 2)
  advAdjt        Decimal?     @db.Decimal(12, 2)
  billAmt        Decimal?     @map("bill_amt") @db.Decimal(12, 2)
  tax            Decimal?     @db.Decimal(12, 2)
  pymt_status    IncomeStatus @map("status")
  txn_status     TxnStatus    @default(UNVERIFIED)
  errorReason    String?      @db.Text
  remarks        String?      @db.Text
  realisedTxnId  Int?         @map("realised_txn_id")
  createdAt      DateTime     @default(now())

  incomeSource  IncomeSource @relation(fields: [incomeSourceId], references: [id])
  patient       Patient?     @relation(fields: [patientId], references: [id])
  ipAdm         IPAdm?       @relation(fields: [ipId], references: [id])
  rcvdPymts     RcvdPymt[]
  payables      Payable[]
  incomeDtls    IncomeDtl[]
  receivables   Receivable[]
  realisedByTxn IncomeTxn?   @relation("RealisedTxn", fields: [realisedTxnId], references: [id])
  realisedTxns  IncomeTxn[]  @relation("RealisedTxn")

  @@index([incomeSourceId])
  @@index([patientId])
  @@index([billNo])
  @@index([billDate])
  @@map("income_txn")
}

model RcvdPymt {
  id            Int       @id @default(autoincrement())
  incomeTxnId   Int
  paymentModeId Int?
  amount        Decimal?  @db.Decimal(12, 2)
  paymentDate   DateTime? @db.Date
  transactionNo String?   @db.VarChar(100)
  bankName      String?   @db.VarChar(100)
  paidBy        String?   @db.VarChar(100)
  remarks       String?

  incomeTxn   IncomeTxn    @relation(fields: [incomeTxnId], references: [id], onDelete: Cascade)
  paymentMode PaymentMode? @relation(fields: [paymentModeId], references: [id])

  @@index([incomeTxnId])
  @@index([paymentModeId])
  @@map("rcvd_pymts")
}

model Payable {
  id            Int           @id @default(autoincrement())
  partyType     PartyType     @map("party_type")
  drId        Int?          @map("dr_id")
  bpId        Int?          @map("bp_id")
  incomeTxnId Int
  billDate    DateTime      @db.Date
  dueDate     DateTime?     @db.Date
  billedAmt   Decimal       @db.Decimal(12, 2)
  payableAmt  Decimal?      @db.Decimal(12, 2)
  balanceAmt  Decimal       @db.Decimal(12, 2)
  status      PayableStatus @default(PENDING)
  remarks     String?       @db.Text
  createdBy   String?       @db.VarChar(100)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  incomeTxn IncomeTxn     @relation(fields: [incomeTxnId], references: [id], onDelete: Cascade)
  doctor    Doctor?       @relation(fields: [drId], references: [id])
  bizPartner BizPartner?  @relation(fields: [bpId], references: [id])
  pymts     PayablePymt[]

  @@index([incomeTxnId])
  @@index([drId])
  @@index([bpId])
  @@map("payable")
}

model PayablePymt {
  id            Int       @id @default(autoincrement())
  payableId     Int
  paymentModeId Int?
  amount        Decimal?  @db.Decimal(12, 2)
  paymentDate   DateTime?
  transactionNo String?   @db.VarChar(100)
  bankName      String?   @db.VarChar(100)
  paidBy        String?   @db.VarChar(100)
  remarks       String?

  payable     Payable      @relation(fields: [payableId], references: [id], onDelete: Cascade)
  paymentMode PaymentMode? @relation(fields: [paymentModeId], references: [id])

  @@index([payableId])
  @@index([paymentModeId])
  @@map("payable_pymts")
}

model IncomeDtl {
  id          Int       @id @default(autoincrement())
  incomeTxnId Int
  uhid        String?   @db.VarChar(50)
  description String?   @db.Text
  amount      Decimal?  @db.Decimal(12, 2)
  billDate    DateTime? @db.Date
  createdBy   String?   @db.VarChar(100)
  createdAt   DateTime  @default(now())

  incomeTxn IncomeTxn @relation(fields: [incomeTxnId], references: [id], onDelete: Cascade)

  @@index([incomeTxnId])
  @@map("income_dtl")
}

model BizPartner {
  id          Int        @id @default(autoincrement())
  bpType      PartyType @map("bp_type")
  bpName      String     @map("bp_Name") @db.VarChar(200)
  contactName String?    @map("contact_name") @db.VarChar(100)
  mobile      String?    @db.VarChar(20)
  email       String?    @db.VarChar(100)
  address     String?    @db.Text
  gstNumber   String?    @map("gst_number") @db.VarChar(30)
  isActive    Boolean    @default(true) @map("is_active")
  createdAt   DateTime   @default(now()) @map("created_at")

  receivables Receivable[]
  payables    Payable[]

  @@map("biz_partner")
}

model Receivable {
  id          Int           @id @default(autoincrement())
  arType      PartyType    @map("ar_type")
  bpId        Int?          @map("bpId")
  // DB CHECK constraint enforces: bpId is mandatory for INSURANCE arType.
  patId       Int           @map("patId")
  incomeTxnId Int?          @map("income_txn_id")
  billDate    DateTime      @map("bill_date") @db.Date
  dueDate     DateTime?     @map("due_date") @db.Date
  dueAmt      Decimal       @map("due_amt") @db.Decimal(12, 2)
  balanceAmt  Decimal       @map("balance_amt") @db.Decimal(12, 2)
  status      PayableStatus @default(PENDING)
  remarks     String?       @db.Text
  createdBy   String?       @map("created_by") @db.VarChar(100)
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  bizPartner BizPartner? @relation(fields: [bpId], references: [id], onDelete: Cascade)
  patient    Patient     @relation(fields: [patId], references: [id], onDelete: Cascade)
  incomeTxn  IncomeTxn?  @relation(fields: [incomeTxnId], references: [id], onDelete: Cascade)
  pymts      RcvlPymt[]

  @@index([bpId])
  @@index([patId])
  @@index([incomeTxnId])
  @@map("receivables")
}

model RcvlPymt {
  id            Int       @id @default(autoincrement())
  rcvlId        Int       @map("rcvl_id")
  paymentModeId Int?      @map("payment_mode_id")
  amount        Decimal?  @db.Decimal(12, 2)
  paymentDate   DateTime? @map("payment_date")
  transactionNo String?   @map("transaction_no") @db.VarChar(100)
  bankName      String?   @map("bank_name") @db.VarChar(100)
  paidBy        String?   @map("paid_by") @db.VarChar(100)
  remarks       String?   @db.Text

  receivable  Receivable   @relation(fields: [rcvlId], references: [id], onDelete: Cascade)
  paymentMode PaymentMode? @relation(fields: [paymentModeId], references: [id])

  @@index([rcvlId])
  @@index([paymentModeId])
  @@map("rcvl_pymts")
}

model IPAdm {
  id        Int      @id @default(autoincrement())
  ipNo      String   @unique @db.VarChar(50)
  date      DateTime @db.Date
  patId     Int
  status    IPStatus
  dischargeDt DateTime? @map("discharge_dt") @db.Date
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  patient    Patient?    @relation(fields: [patId], references: [id])
  incomeTxns IncomeTxn[]

  @@index([patId])
  @@map("ip_adm")
}

